# .cursorignore — Files Cursor should not index or read

# Rust build artifacts (huge, changes constantly, not useful for context)
target/
ui/.svelte-kit/
ui/dist/
ui/node_modules/

# Git internals (never relevant to code changes)
.git/objects/
.git/logs/
.git/refs/

# SQLite database files (binary, not readable)
*.db
*.db-shm
*.db-wal

# Generated files
ui/src/lib/types.d.ts
src-tauri/gen/

# Lock files (useful for dependency tracking but not for code context)
# Cargo.lock and bun.lockb are intentionally NOT ignored — they help with dependency debugging

# Test repos (large, not part of the project)
# ~/Desktop/git-test
# ~/Desktop/express-test

# macOS metadata
.DS_Store
**/.DS_Store

# Editor files
.idea/
*.swp
*.swo
